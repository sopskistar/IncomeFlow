# Public RPCs. A higher-rate private RPC can be used server-side without NEXT_PUBLIC_.
BASE_SEPOLIA_RPC=https://sepolia.base.org
REACTIVE_LASNA_RPC=https://lasna-rpc.rnk.dev/
NEXT_PUBLIC_BASE_SEPOLIA_RPC=https://sepolia.base.org
NEXT_PUBLIC_REACTIVE_LASNA_RPC=https://lasna-rpc.rnk.dev/
# Informational expected network IDs/infrastructure; intentionally pinned, not override inputs.
# Scripts verify RPC chain IDs and code at these official addresses.
BASE_SEPOLIA_CHAIN_ID=84532
REACTIVE_LASNA_CHAIN_ID=5318007
CALLBACK_PROXY=0x476F44b11F5C942c58f4c8E3d0300E5710743585
# Optional override for Foundry binaries. Never put private keys in environment variables.
FORGE_BIN=forge
CAST_BIN=cast
# Existing encrypted Foundry keystore and password-file paths; both are server/local only.
DEPLOY_KEYSTORE=.secrets/deployer
DEPLOY_PASSWORD_FILE=.secrets/password
# Deployment addresses and start blocks are exported to deployments/testnet.json.
# No database, indexer credentials, WalletConnect key or paid provider is required.
