{
  "name": "incomeflow",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "contracts:build": "node scripts/forge.mjs build",
    "contracts:test": "node scripts/forge.mjs test -vv",
    "health": "tsx scripts/health.ts",
    "deploy": "tsx scripts/deploy.ts",
    "proof": "tsx scripts/proof.ts",
    "contracts:bootstrap": "bash scripts/bootstrap-contracts.sh",
    "contracts:export": "node --import tsx scripts/export-contracts.ts",
    "test:live": "node --import tsx scripts/live-browser.ts"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@tanstack/react-query": "5.108.4",
    "lucide-react": "0.468.0",
    "next": "16.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "viem": "2.58.6",
    "wagmi": "3.7.11"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.6",
    "@types/react": "19.3.2",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "type": "module"
}
